# Copy this file to ".env" on the server and fill in every value marked CHANGE.
# Never commit or share the real .env file.

APP_NAME="Monetize Hub"
APP_ENV=production
APP_DEBUG=false
# CHANGE: your real address, with https. Used for links, the sitemap, share images and emails.
APP_URL=https://CHANGE-ME.com
# CHANGE: generate once on the server with `php artisan key:generate --force`. Do not change it afterwards,
# because saved settings (Paystack, SMTP) are encrypted with it.
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- Database: MySQL (create the database and user in your hosting panel first) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE
DB_USERNAME=CHANGE
DB_PASSWORD=CHANGE

# ---- Sessions, cache, queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# ---- Administrator account (read by `php artisan db:seed --class=AdminSeeder`) ----
# CHANGE both. Password: at least 12 characters, not a placeholder.
# After the account is created, DELETE the ADMIN_PASSWORD line. To reset the password later,
# put a new value here, run the seeder again, then delete the line again.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional fallbacks. Everything below can be set in Admin -> Settings instead. ----
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@CHANGE-ME.com"
MAIL_FROM_NAME="${APP_NAME}"
